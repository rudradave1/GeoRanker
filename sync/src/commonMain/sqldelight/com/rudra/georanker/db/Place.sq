CREATE TABLE PlaceEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    rating REAL NOT NULL,
    priceLevel INTEGER NOT NULL,
    category TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

CREATE INDEX idx_place_updatedAt ON PlaceEntity(updatedAt);

insertPlace:
INSERT OR REPLACE INTO PlaceEntity(id, name, latitude, longitude, rating, priceLevel, category, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getAllPlaces:
SELECT * FROM PlaceEntity;

observePlaces:
SELECT * FROM PlaceEntity;

deleteAllPlaces:
DELETE FROM PlaceEntity;
